# SearXNG (hosted on Railway)
SEARXNG_URL=https://capable-emotion-production-6cad.up.railway.app

# AI Provider Configuration
AI_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Ollama Configuration (local first, then Tailscale remote)
OLLAMA_URL=http://localhost:11434
OLLAMA_BASE_URL=http://100.91.220.98:11434/v1
OLLAMA_MODEL=llama3.2

# Groq Cloud API (Tier 2A fallback when Ollama is offline)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini Cloud API (Tier 2B fallback when Ollama is offline)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# API Prefix Configuration (Relative /api for Nginx reverse proxy)
NEXT_PUBLIC_API_URL=/api

# Backend URL (FastAPI running on port 8000 or production URL)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://njepajofhkqeyngikzbu.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

